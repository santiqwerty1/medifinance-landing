---
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en' | 'pt' | 'it';
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const {
  title,
  description = "Gestiona tus pacientes, sesiones e ingresos de forma simple y segura. Precios justos adaptados a tu país."
} = Astro.props;

// Build alternate language URLs
const baseUrl = Astro.site || 'https://medifinance.app';
const currentPath = Astro.url.pathname.replace(/^\/(es|en|pt|it)/, '') || '/';
const alternateUrls = {
  es: `${baseUrl}${currentPath}`,
  en: `${baseUrl}/en${currentPath}`,
  // Ready for future:
  // pt: `${baseUrl}/pt${currentPath}`,
  // it: `${baseUrl}/it${currentPath}`,
};
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL - Prevents duplicate content issues -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Language Alternatives (Global - All Spanish/English Speakers) -->
    <link rel="alternate" hreflang="es" href={alternateUrls.es} />
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="x-default" href={alternateUrls.es} />
    <!-- Ready for future languages:
    <link rel="alternate" hreflang="pt" href={alternateUrls.pt} />
    <link rel="alternate" hreflang="it" href={alternateUrls.it} />
    -->

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="MediFinance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MediFinance - Gestión financiera para profesionales de la salud" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@medifinance" />
    <meta name="twitter:creator" content="@medifinance" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.url)} />
    <meta name="twitter:image:alt" content="MediFinance - Gestión financiera para profesionales de la salud" />

    <!-- Schema.org Structured Data for SEO -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "MediFinance",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web, Android",
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "USD",
          "lowPrice": "0",
          "highPrice": "19.99",
          "offerCount": "3",
          "availability": "https://schema.org/InStock",
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "USD",
            "valueAddedTaxIncluded": "true"
          }
        },
        "description": "Gestión financiera para profesionales de la salud con precios adaptados a tu país (PPP)",
        "audience": {
          "@type": "Audience",
          "audienceType": "Healthcare Professionals"
        },
        "inLanguage": "es",
        "availableLanguage": ["es", "en"],
        "areaServed": [
          {
            "@type": "Country",
            "name": "Argentina"
          },
          {
            "@type": "Country",
            "name": "Spain"
          },
          {
            "@type": "Country",
            "name": "Mexico"
          },
          {
            "@type": "Country",
            "name": "Chile"
          },
          {
            "@type": "Country",
            "name": "United States"
          },
          {
            "@type": "Country",
            "name": "Colombia"
          },
          {
            "@type": "Country",
            "name": "Peru"
          }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "ratingCount": "0",
          "reviewCount": "0"
        }
      }
    </script>

    <!-- Breadcrumb Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://medifinance.app"
        }]
      }
    </script>

    <!-- Google Analytics - Replace G-XXXXXXXXXX with your actual ID -->
    <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script> -->

    <title>{title}</title>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white transition-colors">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
</style>
