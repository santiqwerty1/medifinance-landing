---
// Final Call to Action section
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: 'es' | 'en' | 'pt' | 'it';
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
---

<section class="py-20 bg-gradient-to-br from-purple-600 via-blue-600 to-indigo-600 relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-96 h-96 bg-white rounded-full mix-blend-soft-light filter blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full mix-blend-soft-light filter blur-3xl"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">
      {t.cta.title}
    </h2>
    <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
      {t.cta.subtitle}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
      <a
        href="https://app.medifinance.app"
        class="group px-8 py-4 bg-white text-purple-600 rounded-xl text-lg font-bold hover:bg-gray-100 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
      >
        {t.cta.button}
        <span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">→</span>
      </a>

      <a
        href="#pricing"
        class="px-8 py-4 border-2 border-white text-white rounded-xl text-lg font-bold hover:bg-white/10 transition"
      >
        {lang === 'es' ? 'Ver Planes' : 'View Plans'}
      </a>
    </div>

    <div class="flex flex-wrap gap-6 justify-center text-sm text-purple-100">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        {lang === 'es' ? 'Gratis para siempre' : 'Free forever'}
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        {lang === 'es' ? 'Sin tarjeta de crédito' : 'No credit card'}
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        {lang === 'es' ? 'Configuración en 5 minutos' : '5 minute setup'}
      </div>
    </div>
  </div>
</section>
