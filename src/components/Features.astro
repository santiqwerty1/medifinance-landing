---
// Features section highlighting key capabilities
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: 'es' | 'en' | 'pt' | 'it';
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);

const features = t.features.items;
---

<section id="features" class="py-20 bg-white dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        {t.features.title}
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
        {t.features.subtitle}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, index) => (
        <div
          data-feature-card
          data-index={index}
          class="feature-card group p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 hover:bg-gradient-to-br hover:from-purple-50 hover:to-blue-50 dark:hover:from-purple-900/20 dark:hover:to-blue-900/20 transition-all duration-300 hover:shadow-xl border border-transparent hover:border-purple-200 dark:hover:border-purple-700 cursor-pointer select-text"
          role="button"
          tabindex="0"
          aria-expanded="false"
          aria-label={`${feature.title}. Click to expand`}
        >
          <!-- Header (Always Visible) -->
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-3 flex-1">
              <div class="text-5xl transition-transform duration-300 group-hover:scale-110">
                {feature.icon}
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white leading-tight">
                {feature.title}
              </h3>
            </div>
            <!-- Expand/Collapse indicator -->
            <div class="expand-indicator text-gray-400 dark:text-gray-500 transition-transform duration-300 flex-shrink-0 ml-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>

          <!-- Expandable Description -->
          <div class="feature-content overflow-hidden transition-all duration-300" style="max-height: 0;">
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed pt-2">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Feature card expand/collapse functionality
  document.addEventListener('DOMContentLoaded', () => {
    const featureCards = document.querySelectorAll('[data-feature-card]');

    featureCards.forEach((card) => {
      const content = card.querySelector('.feature-content') as HTMLElement;
      const indicator = card.querySelector('.expand-indicator') as HTMLElement;

      if (!content || !indicator) return;

      const toggleCard = () => {
        const isExpanded = card.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          // Collapse
          card.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0';
          indicator.style.transform = 'rotate(0deg)';
        } else {
          // Expand
          card.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 'px';
          indicator.style.transform = 'rotate(180deg)';
        }
      };

      // Click handler - but allow text selection
      card.addEventListener('mousedown', (e) => {
        const mouseEvent = e as MouseEvent;
        const startX = mouseEvent.clientX;
        const startY = mouseEvent.clientY;

        const handleMouseUp = (upEvent: MouseEvent) => {
          const endX = upEvent.clientX;
          const endY = upEvent.clientY;

          // If mouse didn't move much, it's a click not a selection
          if (Math.abs(endX - startX) < 5 && Math.abs(endY - startY) < 5) {
            toggleCard();
          }

          document.removeEventListener('mouseup', handleMouseUp);
        };

        document.addEventListener('mouseup', handleMouseUp);
      });

      // Handle keyboard navigation
      card.addEventListener('keydown', (e) => {
        const event = e as KeyboardEvent;
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggleCard();
        }
      });
    });
  });
</script>

<style>
  .feature-card {
    position: relative;
  }

  .feature-content {
    transition: max-height 0.3s ease, opacity 0.3s ease;
    opacity: 0;
  }

  .feature-card[aria-expanded="true"] .feature-content {
    opacity: 1;
  }

  .expand-indicator {
    flex-shrink: 0;
  }

  /* Ensure text is selectable */
  .feature-card h3,
  .feature-card p {
    user-select: text;
    -webkit-user-select: text;
    -moz-user-select: text;
    -ms-user-select: text;
  }
</style>
