---
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: 'es' | 'en' | 'pt' | 'it';
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);

const faqs = t.faq.items;
---

<!-- FAQ Schema for Rich Snippets in Google Search -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
})} />

<section id="faq" class="py-20 bg-white dark:bg-gray-900">
  <div class="max-w-4xl mx-auto px-6">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        {t.faq.title}
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        {t.faq.subtitle}
      </p>
    </div>

    <!-- FAQ Items -->
    <div class="space-y-6">
      {faqs.map((faq) => (
        <details class="group rounded-xl bg-gray-50 dark:bg-gray-800 p-6 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
          <summary class="flex justify-between items-center cursor-pointer list-none">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white pr-8">
              {faq.question}
            </h3>
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400 transition-transform group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>

    <!-- Still have questions -->
    <div class="mt-12 text-center p-8 bg-gradient-to-br from-purple-50 to-blue-50 dark:from-purple-900/20 dark:to-blue-900/20 rounded-2xl">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
        {t.faq.moreQuestions}
      </h3>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        {t.faq.moreQuestionsText}
      </p>
      <a
        href="mailto:support@medifinance.app"
        class="inline-block px-6 py-3 bg-purple-600 text-white rounded-lg font-semibold hover:bg-purple-700 transition"
      >
        {t.faq.contact}
      </a>
    </div>

  </div>
</section>
